<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.predator.wake</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{ SCRIPT_PATH | e }}</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>{{ LOG_PATH | e }}</string>
    <key>StandardErrorPath</key>
    <string>{{ LOG_PATH | e }}</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PREDATOR_MODEL</key>
        <string>{{ PREDATOR_MODEL | e }}</string>
        <key>PREDATOR_INPUT_VCP</key>
        <string>{{ PREDATOR_INPUT_VCP | e }}</string>
    </dict>
</dict>
</plist>
